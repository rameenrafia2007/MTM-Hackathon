# MTM Planner configuration. Copy to .env and fill in. .env is git-ignored: never commit keys.
#
# !! SMALL-MODEL LIST: the organizers' list of allowed small models was NOT published in the
# !! task PDF. CONFIRM IT with the organizers (help desk / all-teams WhatsApp group) before the
# !! event and put the confirmed names below. Any model served on THIS laptop (localhost,
# !! e.g. Ollama) counts as small automatically. Run `python -m engine.llm --selftest`:
# !! it prints "BONUS-SAFE: yes/no".

# Provider: "gemini" (Google AI Studio API) or "openai_compatible" (any OpenAI-compatible server, e.g. Ollama)
LLM_PROVIDER=gemini

# --- Gemini (key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Optional: thinking-token budget for Gemini models that support it (0 = off, saves tokens)
# GEMINI_THINKING_BUDGET=0

# --- OpenAI-compatible server (Ollama example) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama

# Model names, tried in this order, then any other discovered model that passes the small filter.
# Leave empty to use discovery only. VERIFY these against the organizers' confirmed list.
MODEL_PRIMARY=
MODEL_FALLBACK=

# Small-model filter. Comma-separated, case-insensitive substrings.
# EXCLUDE always wins over INCLUDE. EXACT = whole names that are always allowed.
# Fill INCLUDE/EXACT from the organizers' confirmed list.
SMALL_MODEL_INCLUDE=
SMALL_MODEL_EXCLUDE=pro,ultra,opus,sonnet,large,405b,70b
SMALL_MODEL_EXACT=

# Clock start used ONLY if the message pack states no start time (the brief says 10:00; confirm).
# EVENT_START_FALLBACK=10:00

# Optional: relocate saved state / outputs (defaults: ./state and ./output)
# MTM_STATE_DIR=state
# MTM_OUTPUT_DIR=output
